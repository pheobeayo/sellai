# --- Meta Model API (required) ---
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# Use the newest Muse Spark model listed in your dashboard
MODEL_AGENT=muse-spark-1.1
MODEL_TRIAGE=muse-spark-1.1
# Muse Voice Transcribe model id (confirm in the model list)
MODEL_TRANSCRIBE=muse-voice-transcribe
# Set to "json_object" only if the API accepts response_format; leave blank otherwise
META_JSON_MODE=

# --- Optional: run comment triage on open weights (Baseten) ---
# When set, triage uses Muse Spark Open; the agent stays on Meta Model API.
TRIAGE_BASE_URL=
TRIAGE_API_KEY=
TRIAGE_MODEL=meta-models/muse-spark-open-1026

# --- Meta platform webhooks (Instagram, Facebook Page, WhatsApp Cloud API) ---
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=choose-any-random-string
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# The vendor's WhatsApp number in international format, no plus sign (used for click-to-chat links)
VENDOR_WHATSAPP_NUMBER=2348000000000
