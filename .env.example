# --- Meta Model API (required) ---
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# Use the newest Muse Spark model listed in your dashboard
MODEL_AGENT=muse-spark-1.3
MODEL_TRIAGE=muse-spark-1.3
# Other Meta models (ids from dev.meta.ai docs)
MODEL_TRANSCRIBE=muse-voice-transcribe-1.0
MODEL_SAM=sam-3.1
MODEL_IMAGE=muse-image-1.0
# Set to "json_object" only if the API accepts response_format; leave blank otherwise
META_JSON_MODE=

# --- Optional: run comment triage on open weights (Baseten) ---
# When set, triage uses Muse Spark Open; the agent stays on Meta Model API.
TRIAGE_BASE_URL=
TRIAGE_API_KEY=
TRIAGE_MODEL=meta-models/muse-spark-open-1026

# --- Database ---
# Supabase: Project Settings → Database → Connection string → "Session pooler" (port 5432).
# Leave empty to use a local database in .data/pglite (no setup needed).
DATABASE_URL=
# PGLITE_DIR=.data/pglite

# --- Public URL of this app, used in short checkout links (/o/SA-XXXX) ---
# Local: http://localhost:3000 · With a tunnel or deploy: your https URL
APP_URL=http://localhost:3000

# --- Meta platform webhooks (Instagram, Facebook Page, WhatsApp Cloud API) ---
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=choose-any-random-string
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Your own WhatsApp number, used by `npm run simulate:whatsapp` as the sender (no plus sign)
SIM_WHATSAPP_FROM=
# The vendor's WhatsApp number in international format, no plus sign (used for click-to-chat links)
VENDOR_WHATSAPP_NUMBER=2348000000000
